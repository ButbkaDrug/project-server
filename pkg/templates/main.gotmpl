<!DOCTYPE html>
<html lang="en">

<head>
  <meta name="description" content="Webpage description goes here" />
  <meta charset="utf-8">
  <title>Welcome to the church</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="">
    <link rel="stylesheet" href="/static/css/tailwind.css"/>
</head>
{{range .Items}}

<h1 class="font-bold text-6xl p-8 truncate bg-purple-300">{{.Name}}</h2>
<div class="container mx-auto">

    <div class="grid grid-cols-1 gap-2">
        {{range .Lyrics.Sections}}
        <div class="my-10">
            <h2 class="font-bold text-6xl my-4 uppercase">{{.Name}}</h2>
            <div class="text-5xl antialiased font-light leading-tight uppercase">
                {{range .Text}}
                   <p class="my-4">{{.}}</p>
                {{end}}
            </div>

        </div>
        {{end}}

    </div>
</div>


{{end}}
